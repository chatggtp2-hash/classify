    "jszip": "^3.10.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3",
    "ts-node-dev": "^2.0.0"
  }
